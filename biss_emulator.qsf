# Provisional compile target. Replace with the actual board device before use.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY biss_emulator_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_global_assignment -name VHDL_FILE rtl/biss_emulator_pkg.vhd
set_global_assignment -name VHDL_FILE rtl/biss_motion_generator.vhd
set_global_assignment -name VHDL_FILE rtl/biss_frame_engine.vhd
set_global_assignment -name VHDL_FILE rtl/biss_emulator_top.vhd
set_global_assignment -name SDC_FILE biss_emulator.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
# These ports will connect to a future board control/debug wrapper.
set_instance_assignment -name VIRTUAL_PIN ON -to cfg_*
set_instance_assignment -name VIRTUAL_PIN ON -to status_*
# Clock/reset/MA/SLO are auto-placed for compile checking only.
# Board pin locations and electrical I/O standards must be supplied before use.

set_global_assignment -name LAST_QUARTUS_VERSION "20.1.1 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top